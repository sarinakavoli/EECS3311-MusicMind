bg=#CFE8FF</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1600</x><y>380</y><w>173</w><h>186</h></coordinates>
    <panel_attributes>Playlist
--
-spotifyId: String
-name: String
-totalDurationMs: int
--
+addTrack(t)
+removeTrack(t)
+totalDuration(): int
--
Stage 2:
-tracks: List&lt;Track&gt;
bg=#CFE8FF</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>700</x><y>1250</y><w>435</w><h>154</h></coordinates>
    <panel_attributes>ValidationResult
--
-passed: boolean
-violations: List&lt;String&gt;
--
+isPassed(): boolean
+violations(): List&lt;String&gt;
--
Stage 2:
-offending: Map&lt;String, List&lt;String&gt;&gt;  (rule -&gt; track ids)
bg=#CFE8FF</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1150</x><y>1000</y><w>258</w><h>218</h></coordinates>
    <panel_attributes>PlaylistSpec
--
-targetMinutes: int
-allowExplicit: boolean
-familiarRatio: double
-blockedArtists: List&lt;String&gt;
-name: String
--
+isBlocked(artistId): boolean
--
Stage 2:
-blockedTracks: List&lt;String&gt;
+isTrackBlocked(trackId): boolean
+blocks(track): boolean
bg=#CFE8FF</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>650</x><y>380</y><w>229</w><h>298</h></coordinates>
