  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>200</x><y>760</y><w>350</w><h>266</h></coordinates>
    <panel_attributes>AgentSession
--
-id: String
-startedAt: DateTime
-status: String
--
+setState(state)
+getState(): SessionState
--
Stage 2:
-request: AgentRequest
-planSteps: List&lt;String&gt;
-playlistId: String
-trace: DecisionTrace
-derivedData: String  (JSON, no track content)
-explanation: String
-notices: List&lt;String&gt;
bg=#CFE8FF</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>40</x><y>190</y><w>166</w><h>82</h></coordinates>
