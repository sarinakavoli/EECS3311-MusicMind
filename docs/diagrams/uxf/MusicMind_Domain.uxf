--
+topGenre(): String
+isEmpty(): boolean
--
Stage 2:
-savedTrackIds: List&lt;String&gt;
-summary: String
-range: String
-partial: boolean
-savedCapped: boolean
-notices: List&lt;String&gt;
+familiarity(track): double
+knownTrackIds(): Set&lt;String&gt;
bg=#CFE8FF</panel_attributes>
    <additional_attributes/>
  </element>
