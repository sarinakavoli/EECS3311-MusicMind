# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Spotify Web API (create an app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# LLM provider (one hosted chat model, reached via the LLMProvider interface)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_model_name_here

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/musicmind
DATABASE_USER=musicmind
DATABASE_PASSWORD=changeme
