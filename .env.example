# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Spotify Web API (create an app at https://developer.spotify.com/dashboard)
# Auth is Authorization Code with PKCE (a public client), so only the CLIENT_ID
# is required. In the Spotify dashboard, add this exact Redirect URI to the app.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# LLM provider (Google Gemini via the LLMProvider interface). Create a key at
# https://aistudio.google.com/apikey . LLM_MODEL is any Gemini model name.
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash

# SQLite (local file, created automatically; replaces the Stage 1 PostgreSQL —
# see docs/STAGE2_PLAN.md). The file is git-ignored.
DATABASE_PATH=musicmind.db
