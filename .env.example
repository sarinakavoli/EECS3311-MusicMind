# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Spotify Web API (create an app at https://developer.spotify.com/dashboard)
# Auth is Authorization Code with PKCE (a public client), so only the CLIENT_ID
# is required. In the Spotify dashboard, add this exact Redirect URI to the app.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# LLM provider (OpenAI via the LLMProvider interface). Create a key at
# https://platform.openai.com/api-keys . LLM_MODEL is any OpenAI chat model;
# when it is unset the default (gpt-4o) from musicmind.properties is used.
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# PostgreSQL (Stage 1 design). Create the database and user first, e.g.:
#   createuser musicmind --pwprompt && createdb -O musicmind musicmind
# Tables are created automatically on first start.
DATABASE_URL=jdbc:postgresql://localhost:5432/musicmind
DATABASE_USER=musicmind
DATABASE_PASSWORD=changeme
